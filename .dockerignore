# Keep the build context small and free of secrets. The image runs its own
# `npm ci`, `prisma generate` and `next build`.
node_modules
.next
out
dist
coverage
*.tsbuildinfo

# Never bake secrets into an image; compose passes them at runtime.
.env
.env.*
!.env.example

.git
.github
.claude
.DS_Store
Thumbs.db
*.log
graphify-out

# Regenerated by `prisma generate` inside the image.
src/generated
prisma/generated

# Not needed to build or run the app.
deploy
docs
for-claude
Dockerfile
.dockerignore
*.md
