# Environment for the Homelab Daily stack (deploy/compose.yml).
# In Komodo, paste this into the stack's Environment and fill in the real values; never commit them.
# What each variable does: see the root .env.example.
#
# Compose reads this file twice: for ${...} substitution in compose.yml (APP_IMAGE, POSTGRES_*)
# and, via env_file, as the environment of the migrate, app and worker containers.
# Use plain KEY=value lines; do not wrap values in quotes.

# --- Image -------------------------------------------------------------------------------
# Published by .github/workflows/image.yml. Pin a build to deploy or roll back, e.g. ghcr.io/OWNER/REPO:sha-abc1234
APP_IMAGE=ghcr.io/OWNER/REPO:latest

# --- PostgreSQL (the bundled container; published on 127.0.0.1:5432 only) ---------------------
POSTGRES_USER=continuum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=continuum
# Must match the three values above. app, worker and migrate run with host networking, so the
# host is 127.0.0.1. Avoid special characters in the password, or URL-encode them here.
DATABASE_URL=postgresql://continuum:change-me@127.0.0.1:5432/continuum?schema=public

# --- Dashboard ---------------------------------------------------------------------------
# Day boundaries, "today" and the timeline are computed in this IANA zone.
DASHBOARD_TIME_ZONE=America/Denver
# Who may connect to :4849 directly: comma-separated IPv4/IPv6 addresses or CIDRs. Loopback is always
# allowed. Empty = everyone. Fill in LAN, NetBird, Tailscale and the Docker network Nginx Proxy Manager
# is on; see "Access control" in deploy/README.md. Placeholders only:
#   DASHBOARD_ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10,172.18.0.0/16
DASHBOARD_ALLOWED_CIDRS=
# Host names the app answers to (the public hostname and the host's own name; no ports). Any other
# name gets 403 (DNS rebinding). IP literals and localhost always pass. Empty = every host name.
#   DASHBOARD_ALLOWED_HOSTS=daily.example.com,ubuntu-main
DASHBOARD_ALLOWED_HOSTS=

# --- Hermes ------------------------------------------------------------------------------
# Bearer token Hermes sends to /api/hermes/* (long random string).
HERMES_DASHBOARD_TOKEN=
# Dashboard -> Hermes API server (host networking, so loopback works).
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=

# --- Seerr -------------------------------------------------------------------------------
SEERR_URL=http://192.168.1.10:5055
SEERR_PUBLIC_URL=https://requests.example.com
SEERR_API_KEY=
SEERR_MOVIE_SERVER_ID=0
SEERR_MOVIE_TEMP_ROOT=/path/to/temp-movies
SEERR_MOVIE_TEMP_PROFILE_ID=1
SEERR_MOVIE_PERMANENT_ROOT=/path/to/movies
SEERR_MOVIE_PERMANENT_PROFILE_ID=1
SEERR_TV_SERVER_ID=0
SEERR_TV_TEMP_ROOT=/path/to/temp-tv
SEERR_TV_TEMP_PROFILE_ID=1
SEERR_TV_PERMANENT_ROOT=/path/to/tv
SEERR_TV_PERMANENT_PROFILE_ID=1
SEERR_ANIME_MOVIE_ROOT=/path/to/anime
SEERR_ANIME_MOVIE_PROFILE_ID=1
SEERR_ANIME_TV_ROOT=/path/to/anime
SEERR_ANIME_TV_PROFILE_ID=1
SEERR_IS_4K=false

# --- Sonarr / Radarr (links only) ----------------------------------------------------------
SONARR_URL=https://sonarr.example.com
RADARR_URL=https://radarr.example.com

# --- Google Calendar (read-only). Get the refresh token with `npm run google:auth` ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- GitHub sync ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_SYNC_OWNER=
GITHUB_SYNC_REPO=
GITHUB_SYNC_INTERVAL_MS=60000

# --- Stocks banner -------------------------------------------------------------------------
FINNHUB_API_KEY=
TIINGO_API_KEY=

# --- Hackathon leftovers (D16 pending); leave blank unless you still use them ---------------
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# CONTINUUM_DEMO_PROJECT_ID=
