# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Docker Compose
POSTGRES_USER=continuum
POSTGRES_PASSWORD=continuum_dev_password
POSTGRES_DB=continuum
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://continuum:continuum_dev_password@localhost:5432/continuum?schema=public

# AI provider configuration (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# GitHub (server-side integration)
GITHUB_TOKEN=
GITHUB_SYNC_OWNER=
GITHUB_SYNC_REPO=
GITHUB_SYNC_INTERVAL_MS=60000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Jira Cloud (server-side)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Google Calendar (read-only; feeds the timeline). Run `npm run google:auth` to get the
# refresh token and list your calendar IDs. Hermes books events with its own Google access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Microsoft Graph (future use)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Project that GitHub auto-sync writes events into
CONTINUUM_DEMO_PROJECT_ID=

# Media apps (browser links only on the orphan-review tiles; no API calls)
SONARR_URL=https://sonarr.example.com
RADARR_URL=https://radarr.example.com

# Homelab Daily
# Day boundaries, "today" and the timeline are computed in this IANA zone.
DASHBOARD_TIME_ZONE=America/Denver

# Who may connect to the app directly: comma-separated IPv4/IPv6 addresses or CIDRs.
# Checked by `npm run start` (scripts/server.ts) against the TCP peer address; X-Forwarded-For and
# X-Real-IP are never trusted. Loopback (127.0.0.0/8, ::1) is always allowed, so the healthcheck and
# Hermes on the same host keep working. Empty = allow everyone (a warning is logged at startup).
# A bad entry stops the server and names the entry. `npm run dev` does not apply the list.
# Example with placeholders (LAN, NetBird/Tailscale, the Docker network Nginx Proxy Manager is on):
#   DASHBOARD_ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10,172.18.0.0/16
DASHBOARD_ALLOWED_CIDRS=
# Host names the dashboard answers to (comma-separated, no ports). Stops DNS rebinding: a request whose
# Host is any other name gets 403. IP literals and localhost always pass. Empty = every host name.
# Example: DASHBOARD_ALLOWED_HOSTS=daily.example.com,ubuntu-main
DASHBOARD_ALLOWED_HOSTS=

# Hermes → dashboard: bearer token Hermes sends to /api/hermes/* (long random string)
HERMES_DASHBOARD_TOKEN=
# Dashboard → Hermes API server (scheduling). The app runs with host networking, so loopback works.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=

# Seerr: the server calls the API over the LAN; the "Open Seerr" link uses the public URL.
SEERR_URL=http://192.168.1.10:5055
SEERR_PUBLIC_URL=https://requests.example.com
SEERR_API_KEY=
# Temp | Permanent library mapping (D14). Approve moves the request here before approving it.
# serverId = Seerr's Radarr/Sonarr server id (from 0); root folder and quality profile id must exist on
# that server. Run `npm run seerr:settings` to list them and check these values.
# Anime (TMDB keyword "anime") always goes to the anime library, whatever Temp/Permanent says.
# is4k is not configurable: Seerr ignores it on PUT /request/{id} and keeps the one the request was created with.
SEERR_MOVIE_SERVER_ID=0
SEERR_MOVIE_TEMP_ROOT=/path/to/temp-movies
SEERR_MOVIE_TEMP_PROFILE_ID=1
SEERR_MOVIE_PERMANENT_ROOT=/path/to/movies
SEERR_MOVIE_PERMANENT_PROFILE_ID=1
SEERR_TV_SERVER_ID=0
SEERR_TV_TEMP_ROOT=/path/to/temp-tv
SEERR_TV_TEMP_PROFILE_ID=1
SEERR_TV_PERMANENT_ROOT=/path/to/tv
SEERR_TV_PERMANENT_PROFILE_ID=1
SEERR_ANIME_MOVIE_ROOT=/path/to/anime
SEERR_ANIME_MOVIE_PROFILE_ID=1
SEERR_ANIME_TV_ROOT=/path/to/anime
SEERR_ANIME_TV_PROFILE_ID=1

# Stocks banner: Finnhub for live quotes (every 5 min), Tiingo for daily history (6-month change)
FINNHUB_API_KEY=
TIINGO_API_KEY=
